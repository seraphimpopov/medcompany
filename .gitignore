# Ядро Bitrix, загрузки и кеши живут только на сервере.
# В репозитории — только собственный код: шаблоны, php_interface, свои компоненты.
/bitrix/*
!/bitrix/templates/
!/bitrix/php_interface/
!/bitrix/components/
/bitrix/components/bitrix/
/bitrix/templates/medcompany (1) (1)/
/upload/
/cgi-bin/
.sass-cache/

# Секреты — никогда не коммитить
/bitrix/php_interface/dbconn.php*
/local/ai-agent/config.php
# Скрипт удалённого выполнения PHP (веб-шелл), см. README → «Безопасность»
/auth/manager.php

